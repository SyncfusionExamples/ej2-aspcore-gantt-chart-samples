<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\webmethodadaptor-client</SpaRoot>
    <SpaProxyLaunchCommand>dotnet run</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:5286</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>8.*-*</Version>
    </PackageReference>
    <PackageReference Include="Syncfusion.EJ2.AspNet.Core" Version="32.2.4" />
  </ItemGroup>

</Project>
